<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="using:MotionMaker.Viewport"
        x:Class="MotionMaker.App.MainWindow"
        Title="Motion Maker"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        KeyDown="OnKeyDown">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" HotKey="Ctrl+N" Click="OnNew"/>
        <MenuItem Header="_Open..." HotKey="Ctrl+O" Click="OnOpen"/>
        <MenuItem Header="_Save" HotKey="Ctrl+S" Click="OnSave"/>
        <MenuItem Header="Save _As..." HotKey="Ctrl+Shift+S" Click="OnSaveAs"/>
        <Separator/>
        <MenuItem Header="_Recent" x:Name="RecentMenu"/>
        <Separator/>
        <MenuItem Header="Export _STL..." Click="OnExportStl"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenu" Header="_Undo" HotKey="Ctrl+Z" Click="OnUndo"/>
        <MenuItem x:Name="RedoMenu" Header="_Redo" HotKey="Ctrl+Y" Click="OnRedo"/>
        <Separator/>
        <MenuItem Header="_Preferences..." Click="OnPreferences"/>
      </MenuItem>
      <MenuItem Header="_Project">
        <MenuItem Header="Add _Assembly" Click="OnAddAssembly"/>
        <MenuItem Header="Add _Part" Click="OnAddPart"/>
        <MenuItem Header="_Rename..." Click="OnRename"/>
        <MenuItem Header="_Delete" Click="OnDelete"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Top" Click="OnTop"/>
        <MenuItem Header="_Front" Click="OnFront"/>
        <MenuItem Header="_Right" Click="OnRight"/>
        <MenuItem Header="_Iso" Click="OnIso"/>
        <Separator/>
        <MenuItem x:Name="PerspectiveMenu" Header="_Perspective" ToggleType="CheckBox" Click="OnPerspective"/>
        <MenuItem Header="Zoom to _plate" HotKey="B" Click="OnFrame"/>
        <MenuItem x:Name="GridMenu" Header="_Grid" ToggleType="CheckBox" IsChecked="True" Click="OnGrid"/>
        <MenuItem x:Name="SnapMenu" Header="_Snap" ToggleType="CheckBox" IsChecked="True" Click="OnSnap"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#2B2D31">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="4,2,4,0">
          <Button x:Name="HomeTab" Classes="ribbon-tab active" Content="Home" Click="OnHomeTab"/>
          <Button x:Name="SketchTab" Classes="ribbon-tab" Content="Sketch" Click="OnSketchTab"/>
          <Button x:Name="FeaturesTab" Classes="ribbon-tab" Content="Features" Click="OnFeaturesTab"/>
        </StackPanel>
        <StackPanel x:Name="HomeRibbon" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="6,4">
          <Button Classes="ribbon" Click="OnNew" ToolTip.Tip="New"><Path Classes="icon" Data="{StaticResource Icon.new}"/></Button>
          <Button Classes="ribbon" Click="OnOpen" ToolTip.Tip="Open"><Path Classes="icon" Data="{StaticResource Icon.open}"/></Button>
          <Button Classes="ribbon" Click="OnSave" ToolTip.Tip="Save"><Path Classes="icon" Data="{StaticResource Icon.save}"/></Button>
          <Separator Width="1" Height="28" Margin="4,0"/>
          <Button Classes="ribbon" Click="OnAddPart" ToolTip.Tip="Part"><Path Classes="icon" Data="{StaticResource Icon.part}"/></Button>
          <Separator Width="1" Height="28" Margin="4,0"/>
          <Button Classes="ribbon" Click="OnTop" ToolTip.Tip="Top"><Path Classes="icon" Data="{StaticResource Icon.top}"/></Button>
          <Button Classes="ribbon" Click="OnFront" ToolTip.Tip="Front"><Path Classes="icon" Data="{StaticResource Icon.front}"/></Button>
          <Button Classes="ribbon" Click="OnRight" ToolTip.Tip="Right"><Path Classes="icon" Data="{StaticResource Icon.right}"/></Button>
          <Button Classes="ribbon" Click="OnIso" ToolTip.Tip="Iso"><Path Classes="icon" Data="{StaticResource Icon.iso}"/></Button>
          <Button Classes="ribbon" Click="OnFrame" ToolTip.Tip="Fit"><Path Classes="icon" Data="{StaticResource Icon.fit}"/></Button>
        </StackPanel>
        <StackPanel x:Name="SketchRibbon" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="6,4" IsVisible="False">
          <Button x:Name="SelectTool" Classes="ribbon" Click="OnSelectTool" ToolTip.Tip="Select"><Path Classes="icon" Data="{StaticResource Icon.select}"/></Button>
          <Button x:Name="LineTool" Classes="ribbon" Click="OnLineTool" ToolTip.Tip="Line"><Path Classes="icon" Data="{StaticResource Icon.line}"/></Button>
          <Button x:Name="RectangleTool" Classes="ribbon" Click="OnRectangleTool" ToolTip.Tip="Rectangle"><Path Classes="icon" Data="{StaticResource Icon.rectangle}"/></Button>
          <Button x:Name="CircleTool" Classes="ribbon" Click="OnCircleTool" ToolTip.Tip="Circle"><Path Classes="icon" Data="{StaticResource Icon.circle}"/></Button>
          <Button x:Name="SlotTool" Classes="ribbon" Click="OnSlotTool" ToolTip.Tip="Slot"><Path Classes="icon" Data="{StaticResource Icon.slot}"/></Button>
          <Separator Width="1" Height="28" Margin="4,0"/>
          <Button x:Name="HorizontalTool" Classes="ribbon" Click="OnHorizontal" ToolTip.Tip="Horizontal"><Path Classes="icon" Data="{StaticResource Icon.horizontal}"/></Button>
          <Button x:Name="VerticalTool" Classes="ribbon" Click="OnVertical" ToolTip.Tip="Vertical"><Path Classes="icon" Data="{StaticResource Icon.vertical}"/></Button>
          <Button x:Name="CoincidentTool" Classes="ribbon" Click="OnCoincident" ToolTip.Tip="Coincident"><Path Classes="icon" Data="{StaticResource Icon.coincident}"/></Button>
          <Button x:Name="LengthTool" Classes="ribbon" Click="OnLength" ToolTip.Tip="Length"><Path Classes="icon" Data="{StaticResource Icon.length}"/></Button>
          <Button x:Name="RadiusTool" Classes="ribbon" Click="OnRadius" ToolTip.Tip="Radius"><Path Classes="icon" Data="{StaticResource Icon.radius}"/></Button>
        </StackPanel>
        <StackPanel x:Name="FeaturesRibbon" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="6,4" IsVisible="False">
          <Button x:Name="PadButton" Classes="ribbon" Click="OnPad" ToolTip.Tip="Pad"><Path Classes="icon" Data="{StaticResource Icon.pad}"/></Button>
          <Button x:Name="HoleButton" Classes="ribbon" Click="OnHole" ToolTip.Tip="Hole"><Path Classes="icon" Data="{StaticResource Icon.hole}"/></Button>
          <Button x:Name="NewSketchButton" Classes="ribbon" Click="OnNewSketch" ToolTip.Tip="New sketch"><Path Classes="icon" Data="{StaticResource Icon.sketch}"/></Button>
          <Separator Width="1" Height="28" Margin="4,0"/>
          <Button x:Name="GearButton" Classes="ribbon" Click="OnGear" ToolTip.Tip="Gear"><Path Classes="icon" Data="{StaticResource Icon.gear}"/></Button>
          <Button x:Name="GearWizardButton" Classes="ribbon" Click="OnGearWizard" ToolTip.Tip="Gear wizard"><Path Classes="icon" Data="{StaticResource Icon.wizard}"/></Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#1E2024" Padding="10,4">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="CursorStatus" VerticalAlignment="Center"/>
        <TextBlock x:Name="ActiveStatus" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="MessageStatus" Grid.Column="2" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Left" Width="280" Background="#24262A" BorderBrush="#3A3D42" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Project" Margin="12,10,12,6" FontWeight="SemiBold"/>
        <TreeView x:Name="Explorer" SelectionChanged="OnExplorerSelectionChanged"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Right" Width="250" Background="#24262A" BorderBrush="#3A3D42" BorderThickness="1,0,0,0" Padding="12">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Text="Properties" FontWeight="SemiBold"/>
          <StackPanel x:Name="PlateProperties" Spacing="6" IsVisible="False">
            <TextBlock Text="Width (mm)"/>
            <NumericUpDown x:Name="PlateWidth" Minimum="10" Maximum="5000" Increment="10" FormatString="0.##" ValueChanged="OnPlateEdited"/>
            <TextBlock Text="Depth (mm)"/>
            <NumericUpDown x:Name="PlateDepth" Minimum="10" Maximum="5000" Increment="10" FormatString="0.##" ValueChanged="OnPlateEdited"/>
          </StackPanel>
          <StackPanel x:Name="FeatureProperties" Spacing="6"/>
          <TextBlock x:Name="PropertyNote" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid x:Name="ViewportHost" Background="#26282E"
          PointerPressed="OnViewportPressed"
          PointerMoved="OnViewportMoved"
          PointerReleased="OnViewportReleased"
          PointerCaptureLost="OnViewportCaptureLost"
          PointerWheelChanged="OnViewportWheel">
      <viewport:SceneView x:Name="Scene" IsHitTestVisible="False"/>
      <Canvas x:Name="MarkerLayer" IsHitTestVisible="False"/>
      <TextBlock x:Name="GlStatus" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0" Foreground="#F0C674" TextWrapping="Wrap" MaxWidth="640"/>
      <Border x:Name="EmptyPrompt" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#CC1E2024" Padding="18,12" CornerRadius="6">
        <TextBlock Text="Add an assembly or a part" FontSize="16"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
